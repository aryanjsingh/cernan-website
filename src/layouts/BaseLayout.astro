---
import '../styles/global.css';

const title = 'Cernan';
const description = 'Cernan is an engineering agency that trains machine learning models, builds cybersecurity systems, and develops software built to last.';
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);
const ogImage = Astro.site && new URL('/assets/logo.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="64x64" href="/assets/logo.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={title} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonical && (
      <>
        <link rel="canonical" href={canonical.href} />
        <meta property="og:url" content={canonical.href} />
      </>
    )}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage.href} />
        <meta property="og:image:alt" content="Cernan engineering agency emblem" />
        <meta name="twitter:image" content={ogImage.href} />
      </>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&family=Newsreader:opsz,wght@6..72,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
