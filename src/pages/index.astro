---
import CloudVeil from '../components/CloudVeil.astro';
import Contact from '../components/Contact.astro';
import Faqs from '../components/Faqs.astro';
import Footer from '../components/Footer.astro';
import Hero from '../components/Hero.astro';
import Research from '../components/Research.astro';
import Security from '../components/Security.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import clouds from '../scripts/clouds.js?raw';
---

<BaseLayout>
  <main>
    <div class="sky-grain" aria-hidden="true"></div>
    <Hero />
    <CloudVeil />
    <Research />
    <Security />
    <Faqs />
    <Contact />
  </main>
  <Footer />

  <!-- These classic scripts run after the canvases exist, in dependency order. -->
  <script is:inline set:html={clouds}></script>
  <script is:inline src="/assets/self-attention-model.js"></script>
  <script is:inline src="/assets/attention-life.js"></script>
  <script is:inline src="/assets/attention-tree.js"></script>
  <script is:inline src="/assets/research-backprop.js"></script>
  <script is:inline src="/assets/security-defense.js"></script>
</BaseLayout>

<style>
  main { position: relative; z-index: 1; }
  .sky-grain {
    position: absolute;
    inset: 0;
    z-index: 10;
    pointer-events: none;
    opacity: .16;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%' height='100%' filter='url(%23n)'/></svg>");
  }
</style>
