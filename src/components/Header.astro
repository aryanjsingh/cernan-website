    transition: opacity .2s;
  }
  .menu a:hover { opacity: 1; }

  .book {
    justify-self: end; position: relative; display: inline-flex; align-items: center; gap: 10px;
    height: 38px; padding: 0 7px 0 16px; border-radius: 999px;
    background: rgba(255, 255, 255, 0.92); color: var(--ink); text-decoration: none;
    font-size: 12px; font-weight: 500; letter-spacing: 0.01em;
    box-shadow: 0 0 0 1px rgba(255, 255, 255, 0.9), 0 1px 2px rgba(11, 26, 43, 0.06), 0 8px 24px rgba(30, 90, 150, 0.16);
    transition: background .25s, box-shadow .25s;
  }
  .book .label { position: relative; display: block; height: 16px; overflow: hidden; line-height: 16px; }
  .book .label span { display: block; transition: transform .45s cubic-bezier(.65, 0, .35, 1); }
  .book .label span + span { position: absolute; left: 0; top: 0; transform: translateY(100%); }
  .book .chip {
    width: 24px; height: 24px; border-radius: 50%; display: grid; place-items: center;
    background: var(--ink); color: var(--white); overflow: hidden; position: relative;
  }
  .book .chip svg { position: absolute; transition: transform .45s cubic-bezier(.65, 0, .35, 1); }
  .book .chip svg + svg { transform: translate(-150%, 150%); }
  .book:hover { background: #fff; box-shadow: 0 0 0 1px #fff, 0 1px 2px rgba(11, 26, 43, 0.08), 0 12px 32px rgba(30, 90, 150, 0.26); }
  .book:hover .label span:first-child { transform: translateY(-100%); }
  .book:hover .label span + span { transform: translateY(0); }
  .book:hover .chip svg:first-child { transform: translate(150%, -150%); }
  .book:hover .chip svg + svg { transform: translate(0, 0); }

  @media (max-width: 720px) {
