<div class="cloud-veil" aria-hidden="true">
  <canvas id="cloud-veil-canvas" class="cloud-veil-canvas"></canvas>
</div>

<script is:inline>
  (() => {
    const canvas = document.getElementById('cloud-veil-canvas');
    if (!canvas) return;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const gl = canvas.getContext('webgl', { alpha: true, antialias: false, premultipliedAlpha: true });
    if (!gl) return;

    const vs = `
      attribute vec2 aPos;
      varying vec2 vUv;
      void main() {
        vUv = aPos * 0.5 + 0.5;
        gl_Position = vec4(aPos, 0.0, 1.0);
      }
    `;

    // Layered fBm volumetric mist & sunlit cumulus bank with seamless top/bottom feathering
    const fs = `
      precision mediump float;
      varying vec2 vUv;
      uniform vec2 uRes;
      uniform float uTime;
      uniform float uScroll;

      float hash(vec2 p) {
        return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453123);
      }
      float noise(vec2 p) {
        vec2 i = floor(p);
        vec2 f = fract(p);
        vec2 u = f * f * (3.0 - 2.0 * f);
        return mix(
          mix(hash(i + vec2(0.0, 0.0)), hash(i + vec2(1.0, 0.0)), u.x),
          mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
          u.y
        );
      }
      float fbm(vec2 p) {
        float v = 0.0;
        float a = 0.52;
        mat2 rot = mat2(0.80, 0.60, -0.60, 0.80);
        for (int i = 0; i < 5; i++) {
          v += a * noise(p);
          p = rot * p * 2.04 + vec2(1.7, 9.2);
          a *= 0.5;
        }
        return v;
      }

      void main() {
        vec2 aspect = vec2(uRes.x / max(uRes.y, 1.0), 1.0);
        vec2 p = vUv * aspect;

        // Vertical envelope: wide soft feathering so top and bottom edges are completely invisible
        float env = smoothstep(0.0, 0.34, vUv.y) * smoothstep(1.0, 0.64, vUv.y);
        if (env <= 0.001) {
          gl_FragColor = vec4(0.0);
          return;
        }

        // Far bank: steady wind drift + rolling internal domain-warp billowing
        vec2 q1 = p * vec2(1.35, 1.95) + vec2(uTime * 0.14 + uScroll * 0.18, sin(uTime * 0.22) * 0.06);
        float warp1 = fbm(q1 * 0.85 + vec2(-uTime * 0.09, uTime * 0.04 + 0.4));
        float warp2 = fbm(q1 * 1.15 + warp1 * 0.7 + vec2(uTime * 0.06, -uTime * 0.05));
        float bank = fbm(q1 + warp2 * 0.72);

        // Near mist: faster drifting foreground wisps with parallax
        vec2 q2 = p * vec2(2.25, 2.9) + vec2(uTime * 0.26 + uScroll * 0.36 + 4.2, -0.3 + cos(uTime * 0.28) * 0.05);
        float wisp = fbm(q2 + warp1 * 0.45);

        // Soft upper-right sunlight shading matching Hero sun bloom
        float litSample = fbm(q1 + warp2 * 0.72 + vec2(0.08, 0.14));
        float shade = clamp((bank - litSample) * 2.5 + 0.64, 0.0, 1.0);

        float density = smoothstep(0.24, 0.74, bank * 0.68 + wisp * 0.48);
        // Pillowy sunlit mist core
        float haze = smoothstep(0.14, 0.48, vUv.y) * smoothstep(0.86, 0.52, vUv.y) * 0.62;
        float alpha = clamp((density * 0.90 + haze) * env, 0.0, 0.98);

        vec3 shadowCol = vec3(0.75, 0.88, 0.99);
        vec3 sunCol = vec3(1.0, 1.0, 1.0);
        vec3 col = mix(shadowCol, sunCol, smoothstep(0.12, 0.88, shade * 0.78 + vUv.y * 0.26));

        gl_FragColor = vec4(col * alpha, alpha);
      }
    `;

    function compile(type, src) {
      const s = gl.createShader(type);
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    }
    const vShader = compile(gl.VERTEX_SHADER, vs);
    const fShader = compile(gl.FRAGMENT_SHADER, fs);
    if (!vShader || !fShader) return;
    const prog = gl.createProgram();
    gl.attachShader(prog, vShader);
    gl.attachShader(prog, fShader);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;

    gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'aPos');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

    const uRes = gl.getUniformLocation(prog, 'uRes');
    const uTime = gl.getUniformLocation(prog, 'uTime');
    const uScroll = gl.getUniformLocation(prog, 'uScroll');

    let w = 1, h = 1, raf = 0, last = 0, elapsed = 0, visible = true;
    let targetScroll = 0, smoothScroll = 0;

    function updateScroll() {
      targetScroll = Math.min(Math.max(window.scrollY / Math.max(window.innerHeight, 1), 0), 3);
    }
    window.addEventListener('scroll', updateScroll, { passive: true });
    updateScroll();
    smoothScroll = targetScroll;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      // Half-res shader is plenty for soft atmospheric mist and super light on GPU
      const scale = Math.min(devicePixelRatio || 1, 1.25) * 0.65;
      w = Math.max(1, Math.round(rect.width * scale));
      h = Math.max(1, Math.round(rect.height * scale));
      canvas.width = w;
      canvas.height = h;
      gl.viewport(0, 0, w, h);
      render(0);
    }

    function render(dt) {
      if (!reduced.matches && dt > 0) {
        elapsed += dt;
        smoothScroll += (targetScroll - smoothScroll) * Math.min(1, dt * 6);
      }
      gl.clearColor(0, 0, 0, 0);
      gl.clear(gl.COLOR_BUFFER_BIT);
      gl.uniform2f(uRes, w, h);
      gl.uniform1f(uTime, elapsed);
      gl.uniform1f(uScroll, smoothScroll);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
    }

    function tick(now) {
      const dt = last ? Math.min((now - last) / 1000, 0.05) : 1 / 60;
      last = now;
      render(dt);
      if (visible && !document.hidden && !reduced.matches) raf = requestAnimationFrame(tick);
      else { raf = 0; last = 0; }
    }

    function ensure() {
      if (reduced.matches) { render(0); return; }
      if (!raf && visible && !document.hidden) { last = 0; raf = requestAnimationFrame(tick); }
    }

    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver((entries) => {
      visible = entries[0] ? entries[0].isIntersecting : true;
      if (visible) ensure();
      else if (raf) { cancelAnimationFrame(raf); raf = 0; last = 0; }
    }, { threshold: 0.01 }).observe(canvas);

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && raf) { cancelAnimationFrame(raf); raf = 0; last = 0; }
      else ensure();
    });
    reduced.addEventListener('change', () => {
      if (reduced.matches && raf) { cancelAnimationFrame(raf); raf = 0; render(0); }
      else ensure();
    });

    resize();
    ensure();
  })();
</script>

<style>
  .cloud-veil {
    position: relative;
    z-index: 3;
    width: 100%;
    height: clamp(460px, 68vh, 700px);
    margin-top: -20vh;
    margin-bottom: -16vh;
    pointer-events: none;
    overflow: hidden;
    background: transparent;
  }
  .cloud-veil-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
