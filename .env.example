# Public site origin (used for canonical URL and og:url)
SITE_URL=https://cernan.co

# Email delivery for POST /api/inquiry (Resend recommended)
RESEND_API_KEY=re_xxxxxxxxx
INQUIRY_TO=admin@cernan.co
INQUIRY_FROM=Cernan Website <inquiries@cernan.co>

# Optional alternative to Resend: forward inquiries to a webhook URL
# INQUIRY_WEBHOOK_URL=https://...
